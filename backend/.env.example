# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=4000

# A long, random secret used to sign session cookies. For example:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Local frontend origin. Set this to the exact deployed frontend URL in production.
FRONTEND_ORIGIN=http://localhost:5173

# Exactly 32 random bytes encoded as base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# Per-user GitHub and Anthropic credentials are entered through Settings and
# stored encrypted in Postgres. Do not set global API credentials here.

# Postgres
DATABASE_URL=postgres://user:password@localhost:5432/ci_insight
